# O app fala com o servidor em server/ (Vercel). As chaves de IA ficam só lá:
# vercel env add GROQ_API_KEY production (e OPENAI_API_KEY / OPENROUTER_API_KEY, se quiser reserva).
# Nunca use o prefixo EXPO_PUBLIC_ para chaves: o Expo coloca essas variáveis dentro do APK.
EXPO_PUBLIC_SHAPE_API_URL=https://shape-ai-api.vercel.app
